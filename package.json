{
  "name": "kaji",
  "version": "0.1.0",
  "description": "Kaji — InfernoJS-native Nostr protocol library",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target browser --format esm",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "@scure/base": "^1.2.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/bun": "latest"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TekkadanPlays/kaji"
  },
  "keywords": ["nostr", "inferno", "infernojs", "protocol", "websocket", "relay"]
}
